# GENERATED - edit env.schema.mjs, then run `npm run env:example`.
#
# Copy to .env and fill in. Nothing here is required for local development.
# Values marked [manifest] are committed and deployed from the manifest;
# set them here only to override locally.

# --- Site -------------------------------------------------------------------
# Canonical origin. Canonicals, sitemap.xml, robots.txt, llms.txt and the
# structured data all derive from it.
NEXT_PUBLIC_SITE_URL=   # [manifest] https://rent-a-vend.com

# Exactly "true" to allow indexing. Production-only, so a preview build cannot
# inherit it.
#
# Stays off until the placeholder prices and photos are gone.
NEXT_PUBLIC_SITE_INDEXABLE=

# --- Enquiry storage --------------------------------------------------------
# Neon Postgres. Use the POOLED host - the one with -pooler - and keep
# ?sslmode=require.
#
# Nothing creates tables at runtime: run `npm run db:migrate` after setting this.
# e.g. postgresql://user:pass@ep-xxx-pooler.eu-central-1.aws.neon.tech/db?sslmode=require
DATABASE_URL=

# --- Admin ------------------------------------------------------------------
# Enables the admin panel. Unset means the panel is disabled, not defaulted.
ADMIN_PASSWORD=

# Signs the admin session cookie. Falls back to ADMIN_PASSWORD, coupling
# rotation to sign-out.
# e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Email ------------------------------------------------------------------
# Sends enquiry notifications, the auto-reply, admin mailbox replies and
# inbound forwards.
# e.g. re_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Sender override. Defaults to the published address; set it on staging so
# previews do not send as the live brand.
# e.g. Rent-a-Vend <info@rent-a-vend.com>
MAIL_FROM=

# The human inbox for notifications and forwarded info@ mail. Never shown to a
# customer.
# e.g. someone@gmail.com
MAIL_TO=

# Verifies the email.received webhook at /api/inbound, which forwards info@
# mail to MAIL_TO.
#
# Resend dashboard -> Webhooks -> add https://<domain>/api/inbound, subscribe to email.received only.
# e.g. whsec_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=

# --- Spam -------------------------------------------------------------------
# Renders the Turnstile widget. Both keys or neither - either alone means no
# bot protection.
# e.g. 0x4AAAAAAA...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Verifies the widget's token. Ignored without a site key, so it cannot refuse
# every enquiry alone.
#
# Local testing: 1x00000000000000000000AA / 1x0000000000000000000000000000000AA always pass.
# e.g. 0x4AAAAAAA...
TURNSTILE_SECRET_KEY=

# --- Map --------------------------------------------------------------------
# Maps Embed key. Ships to the browser, so restrict it by HTTP referrer.
# e.g. AIzaSy...
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Presentation -----------------------------------------------------------
# Set "true" to hide the demo banner, once real prices and photos are in.
NEXT_PUBLIC_HIDE_PLACEHOLDER_BANNER=

# Bare domain. Renders the cookieless Plausible script; unset renders nothing.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=   # [manifest] rent-a-vend.com

# --- Platform ---------------------------------------------------------------
#   VERCEL_ENV  (set by the platform)

#   VERCEL  (set by the platform)

#   VERCEL_DEPLOYMENT_ID  (set by the platform)

#   VERCEL_GIT_COMMIT_SHA  (set by the platform)

#   NODE_ENV  (set by the platform)
