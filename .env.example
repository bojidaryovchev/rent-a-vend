# GENERATED FILE - do not edit.
#
# Written by `npm run env:example` from env.schema.mjs, which is also what
# `npm run env:check` reads and what `npm run env:push` applies to Vercel.
# Edit the manifest, not this file.
#
# Copy to .env.local (or .env - Next loads both, .env.local winning) and fill
# in. Nothing here is required to run the site in development.
#
# One difference worth knowing: Next skips .env.local when NODE_ENV=test and
# loads .env, so a value only in .env.local is invisible to the test run.

# --- Site -------------------------------------------------------------------
# Canonical origin. Canonicals, sitemap.xml, robots.txt, llms.txt and every
# absolute URL in the structured data derive from it.
#
# Where the site lives. A wrong value here is wrong in the one place
# Google reads. Without it, everything points at https://example.invalid.
#
# Committed in env.schema.mjs as "https://rent-a-vend.com", which is the
# source of truth. Set it here only to override locally.
NEXT_PUBLIC_SITE_URL=

# Must be exactly "true". Declared production-only so a preview build cannot
# inherit it and index itself.
#
# Indexing is a separate switch from the site URL, and stays off until the
# placeholder prices and photos are gone. A catalogue indexed at stub prices
# teaches Google figures that are slow to correct.
NEXT_PUBLIC_SITE_INDEXABLE=

# --- Enquiry storage --------------------------------------------------------
# Neon Postgres via Drizzle. Use the POOLED host - the one with -pooler - and
# keep ?sslmode=require.
#
# Without this, enquiries are written to .data/enquiries.json, which is fine
# locally and loses data on any host with an ephemeral filesystem.
#
# Creating the database does NOT create the table. After setting this, run:
#   npm run db:migrate
# and again after any change to src/server/db/schema.ts that has been
# through npm run db:generate. Nothing creates tables at runtime.
#
# Secret: never committed. env:push reads this from your local .env and sends
# it to Vercel encrypted.
# e.g. postgresql://user:password@ep-xxx-pooler.eu-central-1.aws.neon.tech/dbname?sslmode=require
DATABASE_URL=

# --- Admin ------------------------------------------------------------------
# Enables the admin panel. With none set the panel is DISABLED rather than
# defaulted.
#
# A shipped default password is worse than no admin at all.
#
# Secret: never committed. env:push reads this from your local .env and sends
# it to Vercel encrypted.
ADMIN_PASSWORD=

# Signs the admin session cookie. Falls back to ADMIN_PASSWORD, which couples
# password rotation to signing everyone out.
#
# Optional, but set it separately so changing the password does not have to
# invalidate every session.
#
# Secret: never committed. env:push reads this from your local .env and sends
# it to Vercel encrypted.
# e.g. openssl rand -hex 32
ADMIN_SESSION_SECRET=

# --- Email ------------------------------------------------------------------
# Sends the enquiry notification and customer auto-reply; also powers admin
# mailbox replies and inbound forwarding.
#
# Without a key, both messages are logged to the console instead of sent.
# The enquiry is still stored: the database row is the source of truth and
# email is only a notification.
#
# Secret: never committed. env:push reads this from your local .env and sends
# it to Vercel encrypted.
# e.g. re_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY=

# Sender override. Defaults to the published address, which rent-a-vend.com is
# verified to send as (SPF + DKIM).
#
# Set it on a staging deploy, which has no business sending as the live
# brand. Accepts a display name.
# e.g. Rent-a-Vend <info@rent-a-vend.com>
MAIL_FROM=

# The human inbox. Enquiry notifications and mail forwarded from info@ both
# land here, so there is one place to read rather than two.
#
# A plain Gmail address is right: it is never shown to a customer, and
# replies reach the customer because both messages carry his address as
# Reply-To.
#
# Kept out of this repository rather than committed to the manifest,
# because it is a person's inbox and the repository is public.
#
# Secret: never committed. env:push reads this from your local .env and sends
# it to Vercel encrypted.
# e.g. someone@gmail.com
MAIL_TO=

# Verifies the email.received webhook at /api/inbound, which forwards info@
# mail to MAIL_TO.
#
# Sending and receiving are independent: sending needs SPF/DKIM, receiving
# needs MX, and whoever holds the MX record owns the inbox.
#
# Resend does not forward mail on its own - it stores the message and posts
# an email.received webhook. src/app/api/inbound/route.ts is that endpoint
# and src/server/inbound.ts re-sends the message to MAIL_TO with the
# original sender as Reply-To.
#
# To finish the wiring: Resend dashboard -> Webhooks -> add
# https://<domain>/api/inbound, subscribe to email.received ONLY, and paste
# the signing secret here. Without it nothing is forwarded; mail still
# arrives and sits readable in the Resend dashboard.
#
# Secret: never committed. env:push reads this from your local .env and sends
# it to Vercel encrypted.
# e.g. whsec_xxxxxxxxxxxx
RESEND_WEBHOOK_SECRET=

# --- Spam -------------------------------------------------------------------
# Renders the Turnstile widget in the browser. Both keys or neither.
#
# Cloudflare Turnstile, chosen over reCAPTCHA for EU data optics.
#
# BOTH or NEITHER. This key renders the widget
# (src/components/forms/turnstile.tsx); TURNSTILE_SECRET_KEY verifies the
# token it produces (src/server/turnstile.ts). Either half alone means no
# bot protection - env:check says so. With neither, the honeypot and
# server-side validation carry the load.
# e.g. 0x4AAAAAAA...
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Verifies the token the widget produces. Ignored without a site key, so
# setting it alone can no longer refuse every enquiry.
#
# Both come from the same Cloudflare dashboard widget.
#
# Secret: never committed. env:push reads this from your local .env and sends
# it to Vercel encrypted.
# e.g. 0x4AAAAAAA...
TURNSTILE_SECRET_KEY=

# --- Map --------------------------------------------------------------------
# Google Maps Embed API key for the map on "Кои сме ние". Restrict it by HTTP
# referrer.
#
# Free and unmetered, but it must be restricted by HTTP referrer in the
# Google Cloud console: the key ships to the browser, and an unrestricted
# one is someone else's quota.
#
# Without it the section falls back to the address and a link into Google
# Maps, which is a worse map and a perfectly good set of directions.
# e.g. AIzaSy...
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Placeholder guard ------------------------------------------------------
# Set to "true" to hide the yellow demo banner.
#
# Only set this once the real prices, photos and company details are in, or
# screenshots will circulate looking authoritative.
NEXT_PUBLIC_HIDE_PLACEHOLDER_BANNER=

# --- Analytics --------------------------------------------------------------
# Bare domain. Renders the cookieless Plausible script; unset renders nothing.
#
# Plausible, cookieless, so the site needs no consent banner at all. With
# this unset the script is not rendered, so development and preview builds
# send no traffic anywhere.
#
# Committed in env.schema.mjs as "rent-a-vend.com", which is the source of
# truth. Set it here only to override locally.
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# --- Platform ---------------------------------------------------------------
# Gates indexing: isIndexable() requires "production" here, so a preview
# cannot open itself to crawlers.
# Supplied by the platform. Documented here, never set by you.
#   VERCEL_ENV

# Set on every Vercel runtime. Triggers the loud error when enquiries fall
# back to an ephemeral file.
# Supplied by the platform. Documented here, never set by you.
#   VERCEL

# Feeds next.config.ts deploymentId for version-skew protection, so a tab left
# open across a deploy reloads instead of failing.
# Supplied by the platform. Documented here, never set by you.
#   VERCEL_DEPLOYMENT_ID

# Fallback for the deployment id when VERCEL_DEPLOYMENT_ID is absent.
# Supplied by the platform. Documented here, never set by you.
#   VERCEL_GIT_COMMIT_SHA

# Sets `secure` on the admin session cookie.
# Supplied by the platform. Documented here, never set by you.
#   NODE_ENV
