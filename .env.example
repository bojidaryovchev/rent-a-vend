# Copy to .env.local and fill in. Nothing here is required to run the site in
# development, but the readiness report and the admin panel will tell you what
# is missing.

# --- Admin ------------------------------------------------------------------
# With no password set the admin panel is DISABLED rather than falling back to a
# default. A shipped default password is worse than no admin at all.
ADMIN_PASSWORD=
# Optional. Defaults to ADMIN_PASSWORD if unset; set it separately so changing
# the password does not have to invalidate every session.
ADMIN_SESSION_SECRET=

# --- Enquiry storage --------------------------------------------------------
# Without this, enquiries are written to .data/enquiries.json, which is fine
# locally and loses data on any host with an ephemeral filesystem.
DATABASE_URL=

# --- Email ------------------------------------------------------------------
# Without a key, both messages are logged to the console instead of sent. The
# enquiry is still stored: the database row is the source of truth and email is
# only a notification.
RESEND_API_KEY=
# The address customers see. Needs the domain verified in Resend (SPF + DKIM
# records in DNS) - an unverified sender goes to spam or is refused outright.
# Accepts a display name: MAIL_FROM="Вендинг под наем <info@example.bg>"
MAIL_FROM=
# Where enquiry notifications land. A plain Gmail address is fine here; it is
# never shown to a customer. Replies work because the notification carries the
# customer's address as Reply-To.
MAIL_TO=
#
# RECEIVING is a separate decision. People will write to info@<domain> - it is
# printed on the contact page and sits on every acknowledgement - and sending
# alone does not make that address accept mail. Sending needs SPF/DKIM (TXT
# records); receiving needs MX, so whoever holds the MX record owns the inbox
# and the two choices are independent.
#
#   Resend inbound  - included on every plan, free tier covers this volume. Not
#                     a dashboard toggle: it posts an email.received webhook and
#                     we write the forwarder (fetch body via the Received Emails
#                     API, re-send to Gmail). The copy arrives FROM our own
#                     domain, so the forwarder must set Reply-To to the original
#                     sender or replies come back to us.
#   Cloudflare      - dashboard alias to Gmail, no code, free. Simplest.
#   Workspace/Zoho  - a real mailbox, and the ONLY option where a reply leaves
#                     as info@ rather than as the Gmail address.
#
# Only one of these can hold the MX record at a time.

# --- Spam -------------------------------------------------------------------
# Cloudflare Turnstile, chosen over reCAPTCHA for EU data optics. Without a
# secret, the honeypot and server-side validation carry the load.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# --- Map --------------------------------------------------------------------
# Google Maps Embed API key, for the map on "Кои сме ние". Free and unmetered,
# but it must be restricted by HTTP referrer in the Google Cloud console: the
# key ships to the browser, and an unrestricted one is someone else's quota.
# Without it the section falls back to the address and a link into Google Maps,
# which is a worse map and a perfectly good set of directions.
NEXT_PUBLIC_GOOGLE_MAPS_EMBED_KEY=

# --- Placeholder guard ------------------------------------------------------
# Hides the yellow demo banner. Only set this once the real prices, photos and
# company details are in, or screenshots will circulate looking authoritative.
NEXT_PUBLIC_HIDE_PLACEHOLDER_BANNER=
