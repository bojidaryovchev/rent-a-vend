{
  "name": "vending-rental",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "readiness": "node scripts/readiness.mjs",
    "env:check": "node scripts/env-check.mjs",
    "env:push": "node scripts/env-push.mjs",
    "env:example": "node scripts/env-example.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "build:launch": "node scripts/env-example.mjs --check && node scripts/env-check.mjs --strict && node scripts/readiness.mjs --strict && next build",
